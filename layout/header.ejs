    <ul class="d-flex align-center">
        <li class="mr-48 ">
            <a href="../pages/index.html">
                <img src="https://raw.githubusercontent.com/hexschool/2022-web-layout-training/d01fc1896a4289f1b03db4258c0cc716b1f4120d/2025-week1/logo.svg" alt="logo">
